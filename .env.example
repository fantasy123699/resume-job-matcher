# Environment: local | preview | production
APP_ENV=local

# Database. Use a unique production password; never commit it.
POSTGRES_DB=resume_job_matcher
POSTGRES_USER=resume_job_matcher
POSTGRES_PASSWORD=change-me-only-local
DATABASE_URL=postgresql+psycopg://resume_job_matcher:change-me-only-local@localhost:5432/resume_job_matcher

# Authentication. Generate a long, random production value.
# Local only; production must use a different 32+ character value.
SESSION_SECRET=replace-with-a-long-random-secret
# Use https://your-domain.example in production.
WEB_ORIGIN=http://localhost:3000

# Resume imports. Keep this aligned with the 5 MB Caddy request-body limit.
UPLOAD_MAX_BYTES=5242880

# Generated DOCX files are retained for 24 hours. Production Compose mounts this path as a volume.
GENERATED_DOCUMENT_DIR=/app/data/exports

# Public routing. Leave blank with Caddy same-origin routing. For separate local API/Web servers, use http://localhost:8000.
APP_DOMAIN=localhost
NEXT_PUBLIC_API_BASE_URL=

# Model provider. Values are placeholders only.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

# Email. Local development may leave delivery disabled; production must use QQ SMTP.
# Do not use your QQ mailbox login password. Generate an SMTP authorization code in QQ Mail.
MAIL_PROVIDER=disabled
MAIL_FROM=
MAIL_SMTP_HOST=smtp.qq.com
MAIL_SMTP_PORT=465
MAIL_SMTP_USERNAME=
MAIL_SMTP_AUTHORIZATION_CODE=
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# Feature flags. Job platform connectors stay disabled in the first release.
FEATURE_JOB_CONNECTORS=false
FEATURE_AGENT_SEARCH=false
